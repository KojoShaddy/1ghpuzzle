# ============================================================================
# Firebase Frontend Configuration (Set in Vercel Project Settings & .env.local)
# Copy this file to .env.local and fill in the values from your Firebase Console:
# Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)
# ============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Cloud Functions region (defaults to us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: Set to "true" only when running local Firebase Emulators
VITE_USE_FIREBASE_EMULATORS=false
